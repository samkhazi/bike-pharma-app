# Copy this file to .env and fill it. Never send .env to anyone and never put it in GitHub.
RC_API=vrgarage
# The VR Garage login: what you type in VR Garage's email box (email or mobile number), and the password
VRGARAGE_EMAIL=
VRGARAGE_PASSWORD=
# Optional: a token copied from the VR Garage website instead of the login above
# RC_API_KEY=
# Optional: port and address of the demo server (default 3060 on this computer only)
# PORT=3060
# HOST=127.0.0.1
