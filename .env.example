# Bike Pharma site settings (copy to .env). Lines starting with # are comments.
PORT=3010
HOST=127.0.0.1
# where the database and uploaded catalogue files live
DATA_DIR=data
# diagrams/photos folder for staff (copy the project's "catalogues" folder inside it)
FILES_DIR=data/project-files
# OTP for customer/mechanic login: fixed = test OTP shown in the app (not for public use), msg91 = real SMS, log = printed in the server log
# Real SMS by Renflair: put your Renflair API key here, then OTP is real for everyone (OTP_MODE is then ignored)
RENFLAIR_API_KEY=
# only if Renflair's dashboard shows a different send link: {key} {phone} {otp} get filled in
# RENFLAIR_URL=https://sms.renflair.in/V1.php?API={key}&PHONE={phone}&OTP={otp}
OTP_MODE=fixed
OTP_FIXED=123456
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
# how many days a login stays signed in
SESSION_DAYS=30
# folders only staff may open
PROTECTED_DIRS=cat,bj,ph,phh,figs
# Alternate numbers web agent (Admin > More > Alternate numbers). Better: paste the key in that page instead of here.
# ANTHROPIC_API_KEY=
# optional: AI model, how often the agent looks (ms), price per million tokens in $ (in / out), rupees per $
# ALT_MODEL=claude-haiku-5-5
# ALT_TICK_MS=30000
# ALT_PRICE_IN=1
# ALT_PRICE_OUT=5
# ALT_INR=88

# Yamaha chassis search (update 9r): your dealer YPEC login, the values Pymidol's YPEC button sends. Fill on the server only.
YPEC_BASE_CODE=
YPEC_DEALER_CODE=
YPEC_USER_ID=
YPEC_PASSWORD=

# Hero chassis search (update 9s): Hero's e-catalogue answers only servers in India. Turn on once this server is in India,
# or point HERO_URL at an Indian relay of https://ecatalogue.heromotocorp.biz:8080/HeroeCat/
# HERO_VIN=on
# HERO_URL=

# Backups (update 11u): every night after BACKUP_AT (IST hour), kept BACKUP_KEEP days in data/backups (Admin > More > Backups).
# BACKUP_COPY_TO = the other server (user@host:folder) each night's backup is also sent to by rsync over ssh; BACKUP_SSH_KEY = its key file
# BACKUP_AT=2
# BACKUP_KEEP=14
# BACKUP_COPY_TO=
# BACKUP_SSH_KEY=
