# Copy to .env and fill in. Every variable is documented in docs/07-deployment.md.

NODE_ENV=development
PORT=8080
# The public URL of this API. Used to build camera playback links.
PUBLIC_BASE_URL=http://localhost:8080
# Browser origins allowed to call /v1. Capacitor apps use capacitor://localhost (iOS) and https://localhost (Android).
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost

# --- Database (plug and play) ----------------------------------------------
# Any PostgreSQL 13+ database. docker compose up db gives you one on port 5433.
DATABASE_URL=postgres://bikesurgeon:bikesurgeon@localhost:5433/bikesurgeon
# Schema the app's tables live in. Use a dedicated schema (e.g. bike_surgeon_app) when sharing the
# workshop's existing database, so the app never collides with the billing/advisor/mechanic tables.
DB_SCHEMA=public
DB_POOL_MAX=10
# off | require (verify certificate) | no-verify (managed databases with self-signed certs)
DB_SSL=off

# --- Customer sessions -----------------------------------------------------
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=60

# --- Business rules --------------------------------------------------------
WORKSHOP_CODE=DVG-01
GST_RATE=0.18
REFERRAL_REWARD=200
TIMEZONE=Asia/Kolkata

# --- Login codes -----------------------------------------------------------
# console prints codes to the server log (development). http POSTs {phone, code, channel} to your SMS/WhatsApp gateway.
OTP_PROVIDER=console
OTP_HTTP_URL=
OTP_HTTP_TOKEN=
OTP_TTL_SECONDS=300
# Fixed 4-digit code for development and staging only. Ignored when NODE_ENV=production.
OTP_DEV_CODE=4719

# --- Push notifications ----------------------------------------------------
# none | onesignal
PUSH_PROVIDER=none
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# --- Registration (RC) lookup ----------------------------------------------
# GET {VEHICLE_LOOKUP_URL}?registration=KA01MY4500 returning {make, model, colourName, makeYear, chassisLast4}
VEHICLE_LOOKUP_URL=
VEHICLE_LOOKUP_TOKEN=

# --- CRM / ERP integration -------------------------------------------------
# Comma-separated keys accepted in the X-Api-Key header on /integration/v1. openssl rand -hex 24
INTEGRATION_API_KEYS=dev-integration-key-change-me-0123456789
# Where to POST events. Leave empty to only use GET /integration/v1/events.
WEBHOOK_URL=
WEBHOOK_SECRET=
WORKER_INTERVAL_MS=3000

CAMERA_TOKEN_TTL_SECONDS=900
