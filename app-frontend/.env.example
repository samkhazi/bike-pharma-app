# Copy to .env.local (dev) or .env.production (store builds).

# "off" hides the "Test build" group on the Profile screen (sample customer switcher, start over).
# Leave it unset for internal test builds; set it to off for App Store / Play Store builds.
VITE_TEST_TOOLS=off

# The Bike Surgeon API (app-backend). When set, the app runs on real data: login by OTP, the workshop's job cards,
# bills, bays and live bay cameras. Leave it empty for the built-in sample data.
# VITE_API_URL=https://api.bikesurgeon.online
