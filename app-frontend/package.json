{
  "name": "bike-surgeon-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "ios:sync": "npm run build && cap sync ios",
    "android:sync": "npm run build && cap sync android",
    "ios:open": "cap open ios",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --iconBackgroundColor '#f6c31c' --iconBackgroundColorDark '#f6c31c' --splashBackgroundColor '#ffffff' --splashBackgroundColorDark '#1a1917' && rm -rf icons",
    "ios:device": "./scripts/ios-device.sh",
    "typecheck": "tsc --noEmit",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "version": "1.0.0"
}
