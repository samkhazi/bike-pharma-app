rules_version = '2';

// Bike Pharma Firestore rules. Contract: docs/DATA_MODEL.md
// Orders, counters and mechanic ids are written by Cloud Functions (Admin SDK bypasses these rules).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function data() {
      return request.resource.data;
    }
    // Optional field: missing, null, or of the given type.
    function optString(d, k, max) {
      return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max);
    }
    function optTimestamp(d, k) {
      return !(k in d) || d[k] == null || d[k] is timestamp;
    }
    function reqString(d, k, max) {
      return k in d && d[k] is string && d[k].size() > 0 && d[k].size() <= max;
    }

    function validUser(d) {
      return d.keys().hasOnly(['name', 'phone', 'activeVehicleId', 'createdAt', 'updatedAt'])
        && optString(d, 'name', 80)
        && optString(d, 'phone', 20)
        && optString(d, 'activeVehicleId', 128)
        && optTimestamp(d, 'createdAt')
        && optTimestamp(d, 'updatedAt');
    }

    function validVehicle(d) {
      return d.keys().hasOnly(['type', 'regNo', 'brand', 'model', 'year', 'colour', 'emission',
                               'fuel', 'chassisMasked', 'source', 'fitKey', 'createdAt', 'updatedAt'])
        && d.type in ['bike', 'scooter']
        && reqString(d, 'brand', 60)
        && reqString(d, 'model', 80)
        && d.year is int && d.year >= 1950 && d.year <= 2100
        && d.emission in ['BS4', 'BS6']
        && d.source in ['vahan', 'manual']
        && reqString(d, 'fitKey', 150)
        && optString(d, 'regNo', 12)
        && optString(d, 'colour', 40)
        && optString(d, 'fuel', 30)
        && optString(d, 'chassisMasked', 25)
        && optTimestamp(d, 'createdAt')
        && optTimestamp(d, 'updatedAt');
    }

    function validCartItem(d) {
      return d.keys().hasOnly(['qty', 'addedAt'])
        && d.qty is int && d.qty >= 1 && d.qty <= 20
        && optTimestamp(d, 'addedAt');
    }

    // ---------- users (own doc + subcollections only) ----------
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validUser(data());

      match /vehicles/{vehicleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validVehicle(data());
      }

      match /cart/{productId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCartItem(data());
      }
    }

    // ---------- catalogue ----------
    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Customers only see verified + active mechanics. List queries must filter
    // where('verified', '==', true).where('active', '==', true).
    match /mechanics/{mechanicId} {
      allow read: if signedIn()
        && ((resource.data.verified == true && resource.data.active == true) || isAdmin());
      allow write: if isAdmin();
    }

    // ---------- orders (created only by the placeOrder function) ----------
    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, delete: if false;
      // Admins can move the order through its statuses; nothing else.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in
             ['pending_payment', 'placed', 'packed', 'shipped', 'delivered', 'cancelled'];
    }

    // ---------- service bookings ----------
    match /serviceBookings/{bookingId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && data().keys().hasOnly(['uid', 'vehicleId', 'serviceType', 'date', 'slot', 'pickup', 'status', 'createdAt'])
        && data().uid == request.auth.uid
        && data().status == 'booked'
        && reqString(data(), 'vehicleId', 128)
        && reqString(data(), 'serviceType', 80)
        && data().date is string && data().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && reqString(data(), 'slot', 20)
        && data().pickup is bool
        && data().createdAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data.status in ['booked', 'in_progress', 'done', 'cancelled'];
      allow delete: if false;
    }

    // ---------- modify requests ----------
    match /modifyRequests/{requestId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && data().keys().hasOnly(['uid', 'vehicleId', 'items', 'note', 'status', 'createdAt'])
        && data().uid == request.auth.uid
        && data().status == 'new'
        && reqString(data(), 'vehicleId', 128)
        && data().items is list && data().items.size() >= 1 && data().items.size() <= 30
        && optString(data(), 'note', 1000)
        && data().createdAt is timestamp;
      allow update: if isAdmin()
        && request.resource.data.status in ['new', 'quoted', 'closed'];
      allow delete: if false;
    }

    // ---------- admin-only data ----------
    // A signed-in user may read their own admins doc so the app can check "am I admin?".
    match /admins/{adminUid} {
      allow read: if isAdmin() || isOwner(adminUid);
      allow write: if false;
    }

    match /counters/{counterId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else (e.g. rcLookups used by functions) is closed to clients.
  }
}
