# Copy this file to .env and fill it in. Never share .env with anyone.

# Which brands to check when running "python sync.py all"
BRANDS=hero

# Where data, PDFs, Excel and reports are written (default: ./data)
DATA_DIR=./data

# Seconds to wait between requests (be gentle with the brand's server)
REQUEST_DELAY=0.5

# ---- Bajaj EPC (epc.gladminds.co) ----
BAJAJ_EPC_USER=
BAJAJ_EPC_PASS=
# optional CSV "part_no,price" to fill the Price column
BAJAJ_PRICES_CSV=

# ---- Hero e-catalogue (weekly) - no login needed, guest access. Server must be in India. ----
HERO_THREADS=6
HERO_DELAY=0.2

# ---- Hero Connect DMS (monthly) ----
HERO_DMS_USER=
HERO_DMS_PASS=
# optional: your server's URL that receives MRP changes as JSON (see README)
HERO_MRP_WEBHOOK=
HERO_MRP_WEBHOOK_TOKEN=
# set to 1 to watch the browser while debugging
HERO_DMS_HEADFUL=

# ---- TVS dealer DMS (advantagetvs.in) - weekly, OTP typed by you ----
TVS_DEALER_ID=
TVS_USER=
TVS_PASS=
# only if the login page needs a non-default role / branch (exact text from the dropdown)
TVS_ROLE=
TVS_BRANCH=
# OTP page on this server: open this port in the firewall; LINK_BASE = how you reach the server, e.g. http://203.0.113.5:8765
TVS_OTP_PORT=8765
TVS_OTP_LINK_BASE=
# minutes to wait for the OTP
TVS_OTP_WAIT=180
# optional: your server's URL that receives MRP changes as JSON (same format as Hero)
TVS_MRP_WEBHOOK=
TVS_MRP_WEBHOOK_TOKEN=
TVS_HEADFUL=

# ---- Honda e-catalogue (honda2wheelerparts.com) - weekly, login code typed by you ----
HONDA_USER=
HONDA_PASS=
# code page on this server: open this port in the firewall; LINK_BASE = how you reach the server, e.g. http://203.0.113.5:8766
HONDA_CODE_PORT=8766
HONDA_CODE_LINK_BASE=
# minutes to wait for you to type the code
HONDA_CODE_WAIT=180
# seconds between diagram downloads
HONDA_DELAY=0.2
# optional: your server's URL that receives MRP changes as JSON (same format as Hero)
HONDA_MRP_WEBHOOK=
HONDA_MRP_WEBHOOK_TOKEN=
HONDA_HEADFUL=

# ---- optional: email the weekly report (TVS OTP link and Honda code link also come by this email) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_TO=

# ---- Yamaha dealer portal pymidol (www.pymidol.com) - weekly ----
YAMAHA_USER=
YAMAHA_PASS=
# only if pymidol asks for an OTP: the Enter code page goes through the site
YAMAHA_OTP_PORT=8767
YAMAHA_OTP_LINK_BASE=https://bikepharma.com
YAMAHA_OTP_WAIT=180
YAMAHA_DELAY=0.3
YAMAHA_MRP_WEBHOOK=
YAMAHA_MRP_WEBHOOK_TOKEN=
YAMAHA_HEADFUL=

# ---- Royal Enfield dealer EPC (epc.royalenfield.com) - weekly, no OTP / captcha ----
RE_EPC_USER=
RE_EPC_PASS=
# dealer code shown in the EPC address after ?dealer= (leave empty to use the one EPC picks)
RE_EPC_DEALER=
# only this region is read
RE_REGION=INDIA & SAARC
# newest RE MRP list (CSV/XLSX with Part No + MRP columns) goes in DATA_DIR/royal_enfield/mrp/
RE_MRP_WEBHOOK=
RE_MRP_WEBHOOK_TOKEN=
RE_HEADFUL=
# 1 = forget the saved login once (test the full login)
RE_FRESH_LOGIN=
