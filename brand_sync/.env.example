# Copy this file to .env and fill it in. Never share .env with anyone.

# Which brands to check when running "python sync.py all"
BRANDS=hero

# Where data, PDFs, Excel and reports are written (default: ./data)
DATA_DIR=./data

# Seconds to wait between requests (be gentle with the brand's server)
REQUEST_DELAY=0.5

# ---- Bajaj EPC (epc.gladminds.co) ----
BAJAJ_EPC_USER=
BAJAJ_EPC_PASS=
# optional CSV "part_no,price" to fill the Price column
BAJAJ_PRICES_CSV=

# ---- Hero e-catalogue (weekly) - no login needed, guest access. Server must be in India. ----
HERO_THREADS=6
HERO_DELAY=0.2

# ---- Hero Connect DMS (monthly) ----
HERO_DMS_USER=
HERO_DMS_PASS=
# optional: your server's URL that receives MRP changes as JSON (see README)
HERO_MRP_WEBHOOK=
HERO_MRP_WEBHOOK_TOKEN=
# set to 1 to watch the browser while debugging
HERO_DMS_HEADFUL=

# ---- optional: email the weekly report ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_TO=
