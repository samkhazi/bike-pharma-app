#!/usr/bin/env bash
# Stand-in for CloudPanel's clpctl in the CI rehearsal. Like the real one: a site is a site user (home, htdocs/<domain>,
# nvm + Node) plus an nginx file, and a certificate needs an existing site (on 25 Nov 2026 the real one answered
# 'Site "api.bikesurgeon.online" does not exist.' when the first setup had not made the site).
set -euo pipefail
SITES=/etc/clp-sites
cmd=${1:-}; shift || true
declare -A arg
for a in "$@"; do k=${a%%=*}; arg[${k#--}]=${a#*=}; done
echo "clpctl $cmd ${arg[domainName]:-}" >> /tmp/clpctl.log
case "$cmd" in
  site:add:nodejs)
    d=${arg[domainName]}; u=${arg[siteUser]}
    [ ${#arg[siteUserPassword]} -ge 8 ] || { echo "password too short"; exit 1; }
    ! grep -qxF "$d" "$SITES" 2>/dev/null || { echo "Site \"$d\" already exists."; exit 1; }
    ! id "$u" >/dev/null 2>&1 || { echo "Site user \"$u\" already exists."; exit 1; }
    useradd -m -s /bin/bash "$u"
    mkdir -p "/home/$u/htdocs/$d" "/home/$u/logs/nginx"
    printf 'node_modules\n' > "/home/$u/htdocs/.gitignore"   # the real server has a .gitignore next to the site folder
    chown -R "$u:$u" "/home/$u/htdocs"
    mkdir -p /etc/nginx/sites-enabled
    echo "# $d -> 127.0.0.1:${arg[appPort]}" > "/etc/nginx/sites-enabled/$d.conf"
    echo "$d" >> "$SITES"
    su - "$u" -c "curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash >/dev/null 2>&1; . ~/.nvm/nvm.sh; nvm install ${arg[nodejsVersion]} >/dev/null 2>&1"
    echo "Site $d has been created (port ${arg[appPort]})."
    ;;
  lets-encrypt:install:certificate)
    d=${arg[domainName]}
    grep -qxF "$d" "$SITES" 2>/dev/null || { echo "Site \"$d\" does not exist."; exit 1; }
    echo "certificate for $d"
    ;;
  *) echo "unknown command $cmd"; exit 1;;
esac
